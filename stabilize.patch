diff --git a/galileo/stabilize.py b/galileo/stabilize.py
new file mode 100644
index 0000000..0526ec5
--- /dev/null
+++ b/galileo/stabilize.py
@@ -0,0 +1,74 @@
+"""Camera-motion compensation, so a hand-held or leaning phone still measures correctly.
+
+For each frame we estimate a similarity transform (shift, rotation, zoom) of the
+static scene relative to frame 0: corners are tracked frame to frame with
+pyramidal Lucas-Kanade, and RANSAC throws out points on the moving pendulum.
+Tracked positions are then mapped back into frame-0 coordinates.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+from .track import Track
+
+
+def estimate_camera_motion(video_path: str | Path, max_corners: int = 400) -> np.ndarray:
+    """Array (n, 2, 3): affine map from frame-i pixels to frame-0 pixels."""
+    cap = cv2.VideoCapture(str(video_path))
+    ok, frame = cap.read()
+    if not ok:
+        raise RuntimeError(f"cannot read {video_path}")
+    prev = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
+    to_cur = np.eye(3)                    # frame 0 -> current frame
+    maps = [np.eye(3)[:2].copy()]
+    while True:
+        ok, frame = cap.read()
+        if not ok:
+            break
+        cur = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
+        step = np.eye(3)
+        p0 = cv2.goodFeaturesToTrack(prev, max_corners, 0.01, 12)
+        if p0 is not None and len(p0) >= 8:
+            p1, st, _ = cv2.calcOpticalFlowPyrLK(prev, cur, p0, None, winSize=(21, 21), maxLevel=3)
+            good = st.ravel() == 1
+            if good.sum() >= 8:
+                m, _ = cv2.estimateAffinePartial2D(p0[good], p1[good], method=cv2.RANSAC,
+                                                   ransacReprojThreshold=2.0)
+                if m is not None:
+                    step[:2] = m
+        to_cur = step @ to_cur
+        maps.append(np.linalg.inv(to_cur)[:2].copy())
+        prev = cur
+    cap.release()
+    return np.stack(maps)
+
+
+def motion_summary(maps: np.ndarray) -> dict:
+    """How much the camera moved, in px and degrees (for the report and for warnings)."""
+    fwd = np.stack([np.linalg.inv(np.vstack([m, [0, 0, 1]]))[:2] for m in maps])
+    ang = np.degrees(np.arctan2(fwd[:, 1, 0], fwd[:, 0, 0]))
+    return {"shift_x_px": float(np.ptp(fwd[:, 0, 2])), "shift_y_px": float(np.ptp(fwd[:, 1, 2])),
+            "rotation_deg": float(np.ptp(ang))}
+
+
+def apply_to_track(track: Track, maps: np.ndarray) -> Track:
+    """Map every tracked point into frame-0 coordinates."""
+    n = min(len(track.t), len(maps))
+    x, y = track.x.copy(), track.y.copy()
+    m = maps[:n]
+    x[:n] = m[:, 0, 0] * track.x[:n] + m[:, 0, 1] * track.y[:n] + m[:, 0, 2]
+    y[:n] = m[:, 1, 0] * track.x[:n] + m[:, 1, 1] * track.y[:n] + m[:, 1, 2]
+    out = Track(track.t, x, y, track.area, track.conf, track.source, dict(track.meta))
+    out.meta["stabilized"] = True
+    return out
+
+
+def load_or_estimate(video_path: str | Path, cache: str | Path, refresh: bool = False) -> np.ndarray:
+    cache = Path(cache)
+    if refresh or not cache.exists():
+        np.save(cache, estimate_camera_motion(video_path))
+    return np.load(cache)
diff --git a/tests/test_stabilize.py b/tests/test_stabilize.py
new file mode 100644
index 0000000..9fbabce
--- /dev/null
+++ b/tests/test_stabilize.py
@@ -0,0 +1,25 @@
+import cv2
+import numpy as np
+
+from galileo.stabilize import apply_to_track, estimate_camera_motion, motion_summary
+from galileo.track import Track
+
+
+def test_recovers_known_camera_shake(tmp_path):
+    rng = np.random.default_rng(0)
+    scene = cv2.GaussianBlur(rng.integers(0, 255, (520, 680, 3), dtype=np.uint8), (5, 5), 0)
+    shifts = [(0, 0), (3, -2), (6, 1), (-4, 5), (2, 8), (-7, -3)]
+    path = tmp_path / "shake.avi"
+    w = cv2.VideoWriter(str(path), cv2.VideoWriter_fourcc(*"MJPG"), 30, (640, 480))
+    for dx, dy in shifts:  # camera moves -> the scene appears shifted by (dx, dy)
+        w.write(scene[20 - dy:500 - dy, 20 - dx:660 - dx].copy())
+    w.release()
+
+    maps = estimate_camera_motion(path)
+    # A point fixed in the scene, seen at (300 + dx, 200 + dy), must map back to (300, 200).
+    n = len(shifts)
+    x = np.array([300.0 + dx for dx, _ in shifts])
+    y = np.array([200.0 + dy for _, dy in shifts])
+    tr = apply_to_track(Track(np.arange(n) / 30, x, y, np.full(n, np.nan), np.full(n, np.nan)), maps)
+    assert np.allclose(tr.x, 300, atol=0.3) and np.allclose(tr.y, 200, atol=0.3)
+    assert motion_summary(maps)["shift_x_px"] > 10
