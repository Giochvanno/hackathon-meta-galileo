# Meta Model API key from https://dev.meta.ai/platform
MODEL_API_KEY=
# The experimenter agent. Muse Wonder (muse-wonder-1.0) is not offered in every region;
# Muse Spark 1.3 calls tools and reasons. Fallback: muse-spark-1.2.
MODEL_AGENT=muse-spark-1.3
# minimal | low | medium | high | xhigh
AGENT_REASONING=high
